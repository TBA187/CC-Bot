# Copy this file to .env and fill in the credentials.
# Guild, channel, role and forum settings belong in config.json.

# Discord application credentials from the Discord Developer Portal.
TOKEN=your_discord_bot_token
CLIENT_ID=your_discord_application_id

# MySQL Database connection.
DB_HOST=your_database_host
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=your_database_name
DB_PORT=3306

# Accepted storage modes: auto, mysql, json
# - auto: use MySQL when available, fallback to JSON and sync changes to MySQL when back online.
# - mysql: prefer MySQL, fallback to JSON if MySQL is down.
# - json: only use local JSON; never sync those entries to MySQL.
STORAGE_MODE=auto

# Discord Presence - Bot Activity Status (online, idle, dnd(do not disturb), invisible)
BOT_STATUS=online
ACTIVITY_TYPE=Watching
ACTIVITY_NAME="Crow Control"

# # Optional database settings. Uncomment to override the defaults.
# DB_CONNECTION_LIMIT=1
# DB_MAX_IDLE=1
# DB_CONNECT_TIMEOUT_MS=10000
# DB_KEEPALIVE_DELAY_MS=30000
# DB_STARTUP_MAX_RETRIES=3
# DB_RETRY_COOLDOWN_MS=5000
# DB_RETRY_MAX_COOLDOWN_MS=60000
# DB_STATUS_LOG_INTERVAL_MS=300000

# # Optional log settings. The filename receives a monthly suffix, such as cc-2026-11.log.
# BOT_LOG_PATH=data/logs/cc.log
# BOT_LOG_RETENTION_MONTHS=12
# BOT_LOG_MAX_TOTAL_MIB=100
# BOT_LOG_MIN_FREE_MIB=100
# BOT_LOG_CLEANUP_TARGET_FREE_MIB=150
